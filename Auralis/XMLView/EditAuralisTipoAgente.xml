<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Vista de edición de un tipo de agente Auralis.
 */
-->
<view>
    <columns>
        <group name="data" numcolumns="12" valign="center">
            <column name="code" display="none" order="100">
                <widget type="text" fieldname="idtipo" readonly="dinamic"/>
            </column>
            <column name="identifier" numcolumns="5" order="110">
                <widget type="text" fieldname="codigo" maxlength="50"/>
            </column>
            <column name="name" numcolumns="5" order="120">
                <widget type="text" fieldname="nombre" required="true" maxlength="100" icon="fa-solid fa-font"/>
            </column>
            <column name="active" numcolumns="2" order="140">
                <widget type="checkbox" fieldname="activo"/>
            </column>
        </group>
    </columns>
</view>
