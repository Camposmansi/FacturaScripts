<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Vista de listado de tipos de agente Auralis para la pestaña ListTipoAgente.
 */
-->
<view>
    <columns>
        <column name="code" order="100">
            <widget type="text" fieldname="idtipo"/>
        </column>
        <column name="code-custom" title="identifier" order="110">
            <widget type="text" fieldname="codigo"/>
        </column>
        <column name="name" order="120">
            <widget type="text" fieldname="nombre"/>
        </column>
        <column name="active" display="center" order="140">
            <widget type="checkbox" fieldname="activo"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="danger" fieldname="activo" title="inactive">0</option>
        </row>
    </rows>
</view>
