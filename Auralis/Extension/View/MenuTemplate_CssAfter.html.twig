<script>
    (function() {
        {% set activeModoMenu = (fsc.user and fsc.user.auralis_modo_menu) ? fsc.user.auralis_modo_menu : settings('auralis', 'modo_menu', 'horizontal') %}
        var isVertical = {{ activeModoMenu == 'vertical' ? 'true' : 'false' }};
        function updateBodyClass() {
            if (isVertical || window.innerWidth < 992) {
                document.body.classList.add("auralis-vertical-menu");
            } else {
                document.body.classList.remove("auralis-vertical-menu");
            }
        }
        var observer = new MutationObserver(function(mutations) {
            if (document.body) {
                updateBodyClass();
                observer.disconnect();
            }
        });
        observer.observe(document.documentElement, { childList: true });
        window.addEventListener('resize', function() {
            if (document.body) {
                updateBodyClass();
            }
        });
    })();
</script>


