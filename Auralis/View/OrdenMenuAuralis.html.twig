{#
 # @package FacturaScripts
 # @author MansiHost.com
 # @description Plantilla para gestionar la ordenación personalizada del menú en Auralis
 #}

<link rel="stylesheet" href="{{ asset('Dinamic/Assets/CSS/auralis-admin.css') }}?v=1.2"/>

<style>
.sortable-item {
    cursor: grab;
    transition: all 0.18s ease;
    user-select: none;
    min-height: 48px;
    border: 1px solid #e2e8f0;
    border-radius: 8px !important;
    padding: 0.65rem 0.85rem !important;
    margin-bottom: 0.45rem !important;
    background-color: #ffffff;
}
.sortable-item:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}
.sortable-item.dragging {
    opacity: 0.45;
    background-color: #f0fdf4 !important;
    border: 2px dashed #10b981 !important;
    cursor: grabbing !important;
}

/* Estado Activo de Alto Contraste - Nivel 1 */
.sortable-item.selected {
    border: 1px solid rgba(16, 185, 129, 0.5) !important;
    border-left: 5px solid var(--v-primary, var(--bs-primary, #10b981)) !important;
    background-color: rgba(16, 185, 129, 0.09) !important;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.12) !important;
}
.sortable-item.selected .item-title,
.sortable-item.selected span.fw-bold {
    color: #065f46 !important;
    font-weight: 700 !important;
}
.sortable-item.selected .item-icon {
    color: #059669 !important;
}

/* Estado Activo de Alto Contraste - Nivel 2 */
.sortable-item.selected-sub {
    border: 1px solid rgba(16, 185, 129, 0.5) !important;
    border-left: 5px solid var(--v-primary, var(--bs-primary, #10b981)) !important;
    background-color: rgba(16, 185, 129, 0.09) !important;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.12) !important;
}
.sortable-item.selected-sub .item-title,
.sortable-item.selected-sub span.fw-semibold {
    color: #065f46 !important;
    font-weight: 700 !important;
}
.sortable-item.selected-sub .item-icon {
    color: #059669 !important;
}

/* Drag Handle de Alto Contraste */
.drag-handle {
    cursor: grab !important;
    color: #64748b !important;
    padding: 5px 7px;
    border-radius: 5px;
    transition: color 0.15s ease, background-color 0.15s ease;
}
.drag-handle:hover {
    color: #0f172a !important;
    background-color: rgba(0, 0, 0, 0.06);
}
.sortable-item.dragging .drag-handle {
    cursor: grabbing !important;
}
.pointer-events-none {
    pointer-events: none;
}

/* Cabeceras de Columna */
.menu-col-header {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #334155;
    background-color: #f8fafc !important;
    border-bottom: 1px solid #e2e8f0;
}

/* Contenedor Flex que garantiza 3 columnas horizontales estrictas sin salto de línea */
#ordenMenuPanel {
    overflow-x: auto;
    padding-bottom: 0.5rem;
}

#ordenMenuContainer {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    gap: 1rem !important;
    align-items: stretch !important;
    width: 100% !important;
    min-height: 560px !important;
}

/* Columna Nivel 1 */
#colLevel1 {
    flex: 0 0 300px;
    width: 300px;
    min-width: 260px;
    max-width: 320px;
    transition: flex 0.2s ease, width 0.2s ease, min-width 0.2s ease, max-width 0.2s ease;
}

/* Modo Colapsado de Nivel 1 (Fiel al boceto del usuario) */
#colLevel1.is-collapsed {
    flex: 0 0 76px !important;
    width: 76px !important;
    min-width: 76px !important;
    max-width: 76px !important;
    overflow: hidden;
}
#colLevel1.is-collapsed .card-header {
    padding: 0.5rem 0.25rem !important;
    justify-content: center !important;
}
#colLevel1.is-collapsed .card-body {
    padding: 0.25rem !important;
}
#colLevel1.is-collapsed .l1-expanded-only {
    display: none !important;
}
#colLevel1.is-collapsed .l1-collapsed-only {
    display: flex !important;
}
.l1-collapsed-only {
    display: none !important;
}

/* Scrollbar ultrafino y translúcido para el panel colapsado */
#colLevel1.is-collapsed .menu-card-body {
    scrollbar-width: thin;
    scrollbar-color: rgba(16, 185, 129, 0.25) transparent;
}
#colLevel1.is-collapsed .menu-card-body::-webkit-scrollbar {
    width: 4px;
}
#colLevel1.is-collapsed .menu-card-body::-webkit-scrollbar-track {
    background: transparent;
}
#colLevel1.is-collapsed .menu-card-body::-webkit-scrollbar-thumb {
    background-color: rgba(16, 185, 129, 0.25);
    border-radius: 4px;
    transition: background-color 0.2s ease;
}
#colLevel1.is-collapsed .menu-card-body:hover::-webkit-scrollbar-thumb {
    background-color: rgba(16, 185, 129, 0.55);
}

/* Botón Ghost de Expandir */
#btnExpandL1 {
    background-color: transparent !important;
    border: 1px solid transparent !important;
    color: #065f46 !important;
    font-size: 0.95rem;
    padding: 0.35rem 0.5rem !important;
    border-radius: 6px !important;
    transition: all 0.15s ease-in-out;
    box-shadow: none !important;
}
#btnExpandL1:hover,
#btnExpandL1:focus,
#btnExpandL1:active {
    background-color: rgba(16, 185, 129, 0.12) !important;
    border-color: rgba(16, 185, 129, 0.35) !important;
    color: #064e3b !important;
}

/* Alineación Vertical Absoluta e Invariable en Ítems Colapsados */
#colLevel1.is-collapsed .sortable-item {
    padding: 0.75rem 0 !important;
    justify-content: center !important;
    align-items: center !important;
    border-left: 1px solid #e2e8f0 !important;
    width: 100% !important;
}
#colLevel1.is-collapsed .sortable-item.selected {
    border: 1px solid rgba(16, 185, 129, 0.5) !important;
    border-left: 1px solid rgba(16, 185, 129, 0.5) !important;
    box-shadow: inset 4px 0 0 var(--v-primary, var(--bs-primary, #10b981)), 0 2px 8px rgba(16, 185, 129, 0.12) !important;
}
#colLevel1.is-collapsed .sortable-item .item-icon {
    margin: 0 !important;
}

/* Columna Nivel 2 (Submenús) */
#colLevel2 {
    flex: 1 1 0 !important;
    min-width: 280px;
    transition: flex 0.2s ease;
}

/* Columna Nivel 3 (Páginas) */
#colLevel3 {
    flex: 1 1 0 !important;
    min-width: 280px;
    transition: flex 0.2s ease;
}
#colLevel3.d-none {
    display: none !important;
}

.menu-card-body {
    max-height: 620px;
    min-height: 420px;
    overflow-y: auto;
}

/* Dispositivos Móviles (< 768px): Modo Drill-down apilado */
@media (max-width: 767.98px) {
    #ordenMenuContainer {
        flex-direction: column !important;
        min-height: auto !important;
        gap: 0 !important;
    }
    #colLevel1, #colLevel2, #colLevel3 {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 100% !important;
        flex: 1 1 100% !important;
    }
    .mobile-hidden {
        display: none !important;
    }
    .mobile-back-btn {
        display: inline-flex;
        align-items: center;
        color: #065f46 !important;
        background-color: transparent !important;
        border: 1px solid rgba(16, 185, 129, 0.5) !important;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.22rem 0.6rem !important;
        border-radius: 6px !important;
        transition: all 0.15s ease-in-out;
    }
    .mobile-back-btn.d-none {
        display: none !important;
    }
    .mobile-back-btn:hover,
    .mobile-back-btn:focus,
    .mobile-back-btn:active {
        background-color: rgba(16, 185, 129, 0.12) !important;
        color: #064e3b !important;
        border-color: #10b981 !important;
        box-shadow: 0 1px 4px rgba(16, 185, 129, 0.25);
    }
    #colLevel1.is-collapsed {
        flex: 1 1 100% !important;
        width: 100% !important;
        min-width: 100% !important;
        max-width: 100% !important;
    }
    #btnCollapseL1, #btnExpandL1 {
        display: none !important;
    }
    .menu-card-body {
        max-height: calc(100vh - 280px);
        min-height: 320px;
    }
}

/* Tablet (768px a 991.98px): N1 ultra-compacto cuando N3 abre */
@media (min-width: 768px) and (max-width: 991.98px) {
    #colLevel1 {
        flex: 0 0 250px;
        width: 250px;
        min-width: 220px;
    }
    #colLevel1.is-collapsed {
        flex: 0 0 68px !important;
        width: 68px !important;
        min-width: 68px !important;
        max-width: 68px !important;
    }
    #colLevel2, #colLevel3 {
        min-width: 240px;
    }
}
</style>

<div class="container-fluid mt-3 mb-5" id="ordenMenuAuralisApp">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h5 class="card-title mb-0 text-primary fw-bold">
                    <i class="fa-solid fa-bars-staggered me-2"></i>{{ trans('orden-menu-auralis') }}
                </h5>
                <small class="text-muted">{{ trans('personaliza-posicion-menus') }}</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="btnResetMenu" class="btn btn-outline-danger btn-sm px-3">
                    <i class="fa-solid fa-arrow-rotate-left me-1"></i>{{ trans('restablecer-defecto') }}
                </button>
                <button type="button" id="btnSaveMenu" class="btn btn-primary btn-sm px-3">
                    <i class="fa-solid fa-floppy-disk me-1"></i>{{ trans('guardar-actualizar-menu') }}
                </button>
            </div>
        </div>
        <div class="card-body">
            <!-- Toggle de Activación -->
            <div class="p-3 mb-4 rounded bg-light border d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center me-3">
                    <i class="fa-solid fa-power-off fa-lg text-primary me-3"></i>
                    <div>
                        <strong class="d-block">{{ trans('activar-ordenacion-personalizada') }}</strong>
                        <span class="text-muted small">
                            {{ trans('desactivar-ordenacion-help') }}
                        </span>
                    </div>
                </div>
                <div class="form-check form-switch form-switch-lg mb-0">
                    <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="ordenMenuActivoSwitch" {{ fsc.ordenMenuActivo ? 'checked' : '' }}>
                </div>
            </div>

            <!-- Agrupación Admin > General -->
            <div class="p-3 mb-4 rounded bg-light border d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center me-3">
                    <i class="fa-solid fa-layer-group fa-lg text-primary me-3"></i>
                    <div>
                        <strong class="d-block">{{ trans('agrupar-admin-general') }}</strong>
                        <span class="text-muted small">
                            {{ trans('agrupar-admin-general-help') }}
                        </span>
                    </div>
                </div>
                <div class="form-check form-switch form-switch-lg mb-0">
                    <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="agruparAdminGeneralSwitch" {{ fsc.agruparAdminGeneral ? 'checked' : '' }}>
                </div>
            </div>

            {% if fsc.informesPluginActivo %}
            <!-- Agrupación Informes -->
            <div class="p-3 mb-4 rounded bg-light border d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center me-3">
                    <i class="fa-solid fa-chart-column fa-lg text-primary me-3"></i>
                    <div>
                        <strong class="d-block">{{ trans('agrupar-informes-menu') }}</strong>
                        <span class="text-muted small">
                            {{ trans('agrupar-informes-menu-help') }}
                        </span>
                    </div>
                </div>
                <div class="form-check form-switch form-switch-lg mb-0">
                    <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="agruparInformesMenuSwitch" {{ fsc.agruparInformesMenu ? 'checked' : '' }}>
                </div>
            </div>
            {% endif %}

            <!-- Visibilidad de accesos rápidos -->
            <div class="p-3 mb-4 rounded bg-light border">
                <div class="d-flex align-items-center mb-3">
                    <i class="fa-solid fa-eye fa-lg text-primary me-3"></i>
                    <div>
                        <strong class="d-block">Botones de la barra superior</strong>
                        <span class="text-muted small">Muestra u oculta cada acceso de forma independiente en escritorio y móvil.</span>
                    </div>
                </div>
                <div class="row g-2">
                    {% set topbarButtons = [
                        {id: 'topbarShowSearchSwitch', key: 'topbar_show_search', label: 'Búsqueda', icon: 'fa-solid fa-magnifying-glass'},
                        {id: 'topbarShowDashboardSwitch', key: 'topbar_show_dashboard', label: 'Inicio', icon: 'fa-solid fa-house'},
                        {id: 'topbarShowCalendarSwitch', key: 'topbar_show_calendar', label: 'Calendario', icon: 'fa-solid fa-calendar-days'},
                        {id: 'topbarShowNotificationsSwitch', key: 'topbar_show_notifications', label: 'Notificaciones', icon: 'fa-solid fa-bell'},
                        {id: 'topbarShowHelpSwitch', key: 'topbar_show_help', label: 'Ayuda', icon: 'fa-solid fa-circle-question'},
                        {id: 'topbarShowUserSwitch', key: 'topbar_show_user', label: 'Usuario', icon: 'fa-solid fa-circle-user'}
                    ] %}
                    {% for button in topbarButtons %}
                        <div class="col-sm-6 col-xl-4">
                            <label class="d-flex align-items-center justify-content-between bg-white border rounded px-3 py-2 h-100" for="{{ button.id }}">
                                <span class="d-flex align-items-center fw-semibold">
                                    <i class="{{ button.icon }} text-primary me-2" aria-hidden="true"></i>{{ button.label }}
                                </span>
                                <span class="form-check form-switch mb-0 ms-3">
                                    <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="{{ button.id }}" {{ settings('auralis', button.key, true) ? 'checked' : '' }}>
                                </span>
                            </label>
                        </div>
                    {% endfor %}
                </div>
                <div class="form-text mt-2">Pulsa «Guardar y Actualizar Menú» para aplicar los cambios. Si ocultas Usuario, podrás cerrar sesión desde la ficha del usuario o volviendo a activar este botón.</div>
            </div>

            <!-- Panel de Ordenación -->
            <div id="ordenMenuPanel" class="{{ fsc.ordenMenuActivo ? '' : 'opacity-50 pointer-events-none' }}">
                <div id="ordenMenuContainer">
                    <!-- Columna 1: Menús Principales (Nivel 1) -->
                    <div id="colLevel1">
                        <div class="card border h-100 shadow-none d-flex flex-column">
                            <div class="card-header menu-col-header d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="text-truncate d-flex align-items-center l1-expanded-only">
                                    <i class="fa-solid fa-folder me-2 text-primary"></i>
                                    <span>{{ trans('menus-principales-n1') }}</span>
                                </span>
                                <div class="d-flex align-items-center gap-1 l1-expanded-only">
                                    <span class="badge bg-primary rounded-pill" id="countLevel1">0</span>
                                    <button type="button" id="btnCollapseL1" class="btn btn-sm btn-white border py-0 px-2 ms-1" title="{{ trans('colapsar-nivel-1') }} (⇤)">
                                        <i class="fa-solid fa-angles-left"></i>
                                    </button>
                                </div>
                                <div class="w-100 justify-content-center l1-collapsed-only">
                                    <button type="button" id="btnExpandL1" class="btn btn-sm py-1 px-2 w-100" title="{{ trans('expandir-nivel-1') }} (⇥)">
                                        <i class="fa-solid fa-angles-right"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-2 flex-grow-1 menu-card-body">
                                <ul class="list-group sortable-list" id="listLevel1" style="min-height: 200px;">
                                    {# Renderizado vía JS #}
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Columna 2: Submenús (Nivel 2) -->
                    <div id="colLevel2">
                        <div class="card border h-100 shadow-none d-flex flex-column">
                            <div class="card-header menu-col-header d-flex justify-content-between align-items-center py-2 px-3">
                                <div class="d-flex align-items-center text-truncate me-2">
                                    <button type="button" id="btnBackToL1" class="btn btn-sm py-0 px-2 me-2 d-none mobile-back-btn" title="{{ trans('volver-a-menus') }}">
                                        <i class="fa-solid fa-arrow-left me-1"></i>{{ trans('volver-a-menus') }}
                                    </button>
                                    <i class="fa-solid fa-list-check me-2 text-primary"></i>
                                    <span class="text-truncate">
                                        {{ trans('submenus-de') }} <span id="selectedMenuTitle" class="text-primary fw-bold">{{ trans('selecciona-un-menu') }}</span>
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary rounded-pill" id="countLevel2">0</span>
                                    <button type="button" id="btnCloseL2" class="btn btn-sm btn-outline-secondary py-0 px-2 d-none" title="{{ trans('limpiar-seleccion') }}">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-2 flex-grow-1 menu-card-body">
                                <div id="noMenuSelectedAlert" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-hand-pointer fa-2x mb-2 d-block opacity-50"></i>
                                    {{ trans('clic-reordenar-elementos') }}
                                </div>
                                <ul class="list-group sortable-list d-none" id="listLevel2" style="min-height: 200px;">
                                    {# Renderizado vía JS #}
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Columna 3: Páginas (Nivel 3) -->
                    <div id="colLevel3" class="d-none">
                        <div class="card border h-100 shadow-none d-flex flex-column">
                            <div class="card-header menu-col-header d-flex justify-content-between align-items-center py-2 px-3">
                                <div class="d-flex align-items-center text-truncate me-2">
                                    <button type="button" id="btnBackToL2" class="btn btn-sm py-0 px-2 me-2 d-none mobile-back-btn" title="{{ trans('volver-a-submenus') }}">
                                        <i class="fa-solid fa-arrow-left me-1"></i>{{ trans('volver-a-submenus') }}
                                    </button>
                                    <i class="fa-solid fa-file-lines me-2 text-primary"></i>
                                    <span class="text-truncate">
                                        {{ trans('paginas-de') }} <span id="selectedSubmenuTitle" class="text-primary fw-bold">{{ trans('selecciona-un-submenu') }}</span>
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary rounded-pill" id="countLevel3">0</span>
                                    <button type="button" id="btnCloseL3" class="btn btn-sm btn-outline-secondary py-0 px-2" title="{{ trans('cerrar') }}">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-2 flex-grow-1 menu-card-body">
                                <div id="noSubmenuSelectedAlert" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-hand-pointer fa-2x mb-2 d-block opacity-50"></i>
                                    {{ trans('clic-reordenar-paginas') }}
                                </div>
                                <ul class="list-group sortable-list d-none" id="listLevel3" style="min-height: 200px;">
                                    {# Renderizado vía JS #}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'Master/_auralis_i18n_script.html.twig' %}
<script>
window.AuralisMenuData = {
    tree: {{ fsc.menuTree|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
    savedOrders: {{ fsc.savedOrders|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
    ordenActivo: {{ fsc.ordenMenuActivo ? 'true' : 'false' }},
    urlSave: '{{ fsc.url() }}',
    formToken: '{{ formToken(false) }}'
};
</script>
<script src="{{ asset('Dinamic/Assets/JS/auralis-menu-order.js') }}?v=2.3"></script>
