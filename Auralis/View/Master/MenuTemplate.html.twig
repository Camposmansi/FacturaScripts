        <script>
            function toggleAuralisSidebar() {
                const body = document.body;
                if (window.innerWidth >= {{ mobileBreakpoint }}) {
                    body.classList.toggle("auralis-sidebar-closed");
                    localStorage.setItem("auralis_sidebar", body.classList.contains("auralis-sidebar-closed") ? "closed" : "open");
                } else {
                    body.classList.toggle("auralis-sidebar-open");
                    const overlay = document.getElementById("sidebar-overlay");
                    if (overlay) {
                        if (body.classList.contains("auralis-sidebar-open")) {
                            overlay.style.display = "block";
                        } else {
                            overlay.style.display = "none";
                        }
                    }
                }
            }

            function showAuralisSidebar() {
                const body = document.body;
                if (window.innerWidth < {{ mobileBreakpoint }}) {
                    body.classList.add("auralis-sidebar-open");
                    const overlay = document.getElementById("sidebar-overlay");
                    if (overlay) overlay.style.display = "block";
                } else {
                    body.classList.remove("auralis-sidebar-closed");
                    localStorage.setItem("auralis_sidebar", "open");
                }
            }

            function hideAuralisSidebar() {
                const body = document.body;
                if (window.innerWidth < {{ mobileBreakpoint }}) {
                    body.classList.remove("auralis-sidebar-open");
                    const overlay = document.getElementById("sidebar-overlay");
                    if (overlay) overlay.style.display = "none";
                } else {
                    body.classList.add("auralis-sidebar-closed");
                    localStorage.setItem("auralis_sidebar", "closed");
                }
            }
        </script>
