{% macro showMenu(item, parentCollapseId) %}
    {% import _self as macros %}
    {% set active = item.active ? 'active' : '' %}
    {% set menuItemClass = item.active ? 'sidebar-menu-item-active' : '' %}
    {% set collapseId = 'sideMenu' ~ item.name %}
    {% set collapseParent = ' data-bs-parent="' ~ parentCollapseId ~ '"' %}
    <li class="nav-item {{ active }}">
        {% if item.menu is empty %}
            <a href="{{ item.url }}" class="nav-link {{ menuItemClass }}">
                <i class="{{ item.icon }} fa-fw me-1" aria-hidden="true"></i> {{ item.title }}
            </a>
        {% elseif item.active %}
            <a href="#{{ collapseId }}" data-bs-toggle="collapse" aria-expanded="true"
               class="nav-link dropdown-toggle pt-2 pb-2">
                <i class="fa-solid fa-folder-open fa-fw me-1" aria-hidden="true"></i> {{ item.title }}
            </a>
            <ul class="collapse show" id="{{ collapseId }}"{{ collapseParent|raw }}>
                {% for subitem in item.menu %}
                    {{ _self.showMenu(subitem, '#' ~ collapseId) }}
                {% endfor %}
            </ul>
        {% else %}
            <a href="#{{ collapseId }}" data-bs-toggle="collapse" aria-expanded="false"
               class="nav-link dropdown-toggle pt-2 pb-2">
                <i class="fa-solid fa-folder fa-fw me-1" aria-hidden="true"></i> {{ item.title }}
            </a>
            <ul class="collapse" id="{{ collapseId }}"{{ collapseParent|raw }}>
                {% for subitem in item.menu %}
                    {{ _self.showMenu(subitem, '#' ~ collapseId) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}
