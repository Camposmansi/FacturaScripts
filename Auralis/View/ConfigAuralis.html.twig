{#
 # @package FacturaScripts
 # @author MansiHost.com
 # @description Plantilla de la interfaz de configuración del tema Auralis
 #}

<link rel="stylesheet" href="{{ asset('Dinamic/Assets/CSS/auralis-admin.css') }}?v=1.7-check"/>

<div class="auralis-admin-container mt-3">
    <div class="row">
        <!-- Panel de Configuración -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="fa-solid fa-sliders me-2"></i>{{ trans('configuracion-auralis') }}
                    </h5>
                    <button type="submit" form="auralisConfigForm" class="btn btn-primary btn-sm px-3">
                        <i class="fa-solid fa-floppy-disk me-1"></i>{{ trans('guardar') }}
                    </button>
                </div>
                <div class="card-body py-4">
                    <form method="post" action="{{ fsc.url() }}" id="auralisConfigForm" enctype="multipart/form-data">
                        {{ formToken() }}
                        <input type="hidden" name="action" value="save"/>
                        <input type="hidden" name="activetab" value="Auralis"/>
                        <script>(function(){var i=document.querySelector('#auralisConfigForm input[name="multireqtoken"]');if(i&&i.value){window.AURALIS_LIBRARY_CSRF=i.value;}})();</script>

                        <!-- Sección 1: Modo de Menú -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary mb-3">
                                <i class="fa-solid fa-bars-staggered me-2 text-primary"></i>{{ trans('modo-menu') }}
                            </label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="menu-mode-card {{ settings('auralis', 'modo_menu', 'horizontal') == 'horizontal' ? 'active' : '' }}">
                                        <input class="form-check-input d-none" type="radio" name="modo_menu" id="menu_horizontal" value="horizontal" {{ settings('auralis', 'modo_menu', 'horizontal') == 'horizontal' ? 'checked' : '' }}>
                                        <label class="form-check-label w-100 p-3 cursor-pointer" for="menu_horizontal">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-wrapper me-3">
                                                    <i class="fa-solid fa-window-maximize fa-2x"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">{{ trans('horizontal') }}</div>
                                                    <small class="text-muted">{{ trans('barra-superior-defecto') }}</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="menu-mode-card {{ settings('auralis', 'modo_menu', 'horizontal') == 'vertical' ? 'active' : '' }}">
                                        <input class="form-check-input d-none" type="radio" name="modo_menu" id="menu_vertical" value="vertical" {{ settings('auralis', 'modo_menu', 'horizontal') == 'vertical' ? 'checked' : '' }}>
                                        <label class="form-check-label w-100 p-3 cursor-pointer" for="menu_vertical">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-wrapper me-3">
                                                    <i class="fa-solid fa-columns fa-2x"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">{{ trans('vertical') }}</div>
                                                    <small class="text-muted">{{ trans('menu-lateral-ocultable') }}</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" name="menu_horizontal_hide_empresa" id="menu_horizontal_hide_empresa" value="1" {{ settings('auralis', 'menu_horizontal_hide_empresa', '0') == '1' ? 'checked' : '' }}>
                                <label class="form-check-label" for="menu_horizontal_hide_empresa">
                                    {{ trans('menu-horizontal-hide-empresa') }}
                                    <small class="d-block text-muted">{{ trans('menu-horizontal-hide-empresa-help') }}</small>
                                </label>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25"/>

                        <!-- Sección 2: Selector de Color -->
                        <div class="mb-4">
                            {% set currentTheme = settings('auralis', 'tema_color', 'default') %}
                            {% set isSecondaryThemeActive = currentTheme in ['kinetic', 'nord', 'zafiro', 'pergamino', 'zen', 'prestige', 'nexus', 'cyber', 'crimson', 'blaze', 'serenity', 'terra'] %}
