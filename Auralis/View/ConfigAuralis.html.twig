                            <!-- Cuadrícula de los 4 temas principales -->
                            <div class="row g-3">
                                <!-- Tema 1: Predeterminado -->
                                <div class="col-12 col-sm-6">
                                    <div class="theme-color-card h-100 {{ currentTheme == 'default' ? 'active' : '' }}">
                                        <input class="form-check-input d-none" type="radio" name="tema_color" id="theme_default" value="default" {{ currentTheme == 'default' ? 'checked' : '' }}>
                                        <label class="form-check-label w-100 p-3 cursor-pointer d-flex align-items-center justify-content-between mb-0" for="theme_default">
                                            <div class="d-flex align-items-center me-2 min-w-0">
                                                <div class="color-preview-dots me-3">
                                                    <span class="dot" style="background-color: #0d6efd;"></span>
                                                    <span class="dot" style="background-color: #212529;"></span>
                                                </div>
                                                <div class="text-truncate">
                                                    <div class="fw-bold text-dark auralis-admin-theme-title">{{ trans('predeterminado') }}</div>
                                                    <small class="text-muted text-truncate d-block auralis-admin-theme-desc">{{ trans('estilo-fs-nativo') }}</small>
                                                </div>
                                            </div>
                                            <div class="theme-check-icon flex-shrink-0 ms-2">
