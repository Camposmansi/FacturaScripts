                                            <div class="d-flex align-items-center me-2 min-w-0">
                                                <div class="color-preview-dots me-3">
                                                    <span class="dot" style="background-color: #10b981;"></span>
                                                    <span class="dot" style="background-color: #ffffff; border: 1px solid #cbd5e1;"></span>
                                                </div>
                                                <div class="text-truncate">
                                                    <div class="fw-bold text-dark auralis-admin-theme-title">{{ trans('auralis-claro') }}</div>
                                                    <small class="text-muted text-truncate d-block auralis-admin-theme-desc">{{ trans('interfaz-lateral-claro') }}</small>
                                                </div>
                                            </div>
                                            <div class="theme-check-icon flex-shrink-0 ms-2">
                                                <i class="fa-solid fa-circle-check"></i>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <!-- Tema 3: Auralis Oscuro -->
