{% extends "Master/MenuTemplate.html.twig" %}
{% import 'Macro/Utils.html.twig' as Utils %}

{% block body %}
    {{ parent() }}

    <div class="auralis-dashboard">
        <!-- Cabecera -->
        <div class="auralis-dashboard-head">
            <div>
                <h1 class="auralis-dashboard-title d-flex align-items-center gap-2 flex-wrap">
                    {% if fsc.getPageData().name == fsc.user.homepage %}
                        <a class="btn btn-sm btn-secondary active" href="{{ fsc.url() }}?defaultPage=FALSE"
                           title="{{ trans('marked-as-homepage') }}">
                            <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
                        </a>
                    {% else %}
                        <a class="btn btn-sm btn-secondary" href="{{ fsc.url() }}?defaultPage=TRUE"
                           title="{{ trans('mark-as-homepage') }}">
                            <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    <span>{{ trans('hello')|default('¡Hola') }}, {{ fsc.user.nick }}!</span>
                </h1>
                <div class="auralis-dashboard-subtitle d-flex align-items-center flex-wrap gap-2">
                    <span>{{ trans('dashboard-subtitle')|default('Aquí tienes un resumen de la salud financiera de tu negocio.') }}</span>
                </div>
            </div>
            <div class="auralis-quick-actions">
                <a href="EditFacturaCliente" class="btn-auralis-action btn-auralis-action-primary">
                    <i class="fa-solid fa-plus"></i> {{ trans('new-sale')|default('Nueva Venta') }}
                </a>
                <a href="EditFacturaProveedor" class="btn-auralis-action btn-auralis-action-secondary">
                    <i class="fa-solid fa-plus"></i> {{ trans('new-expense')|default('Nuevo Gasto') }}
                </a>
                <a href="EditCliente" class="btn-auralis-action btn-auralis-action-secondary">
                    <i class="fa-solid fa-user-plus"></i> {{ trans('new-client')|default('Nuevo Cliente') }}
                </a>
            </div>
        </div>

        <!-- Barra de Filtros -->
        <div class="auralis-filters-bar">
            <div class="auralis-filters-left">
                <div class="d-flex gap-2 flex-wrap">
                    <button class="auralis-filter-btn {% if fsc.rango == 'last-7-days' %}active{% endif %}" data-rango="last-7-days">7 días</button>
                    <button class="auralis-filter-btn {% if fsc.rango == 'last-30-days' %}active{% endif %}" data-rango="last-30-days">30 días</button>
                    <button class="auralis-filter-btn {% if fsc.rango == 'this-month' %}active{% endif %}" data-rango="this-month">
                        {{ trans('este-mes')|default('Este Mes') }}
                    </button>
                    <button class="auralis-filter-btn {% if fsc.rango == 'this-quarter' %}active{% endif %}" data-rango="this-quarter">
                        {{ trans('este-trimestre')|default('Este Trimestre') }}
                    </button>
                    <button class="auralis-filter-btn {% if fsc.rango == 'this-year' %}active{% endif %}" data-rango="this-year">
                        {{ trans('ano-actual')|default('Año Actual') }}
                    </button>
                    <button class="auralis-filter-btn {% if fsc.rango == 'last-6-months' %}active{% endif %}" data-rango="last-6-months">6 meses</button>
                    <button class="auralis-filter-btn {% if fsc.rango == 'last-12-months' %}active{% endif %}" data-rango="last-12-months">12 meses</button>
                    <button class="auralis-filter-btn {% if fsc.rango == 'last-3-years' %}active{% endif %}" data-rango="last-3-years">3 años</button>
                </div>
                
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small text-nowrap">{{ trans('from')|default('Desde') }}:</span>
                        <input type="date" id="filterDesde" class="form-control" style="width: 10.5rem;" value="{{ fsc.desde }}">
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small text-nowrap">{{ trans('hasta')|default('Hasta') }}:</span>
                        <input type="date" id="filterHasta" class="form-control" style="width: 10.5rem;" value="{{ fsc.hasta }}">
                    </div>
                    <button type="button" class="btn btn-primary" id="btnApplyCustomDates" title="{{ trans('refresh')|default('Actualizar') }}">
                        <i class="fa-solid fa-sync"></i>
                    </button>
                </div>

                {% if fsc.hasMultiEmpresa %}
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-building text-muted" aria-hidden="true"></i>
                        <select id="filterEmpresa" class="form-select" style="min-width: 16rem; width: auto;"
                                aria-label="{{ trans('company')|default('Empresa') }}">
                            <option value="">{{ trans('todas-las-empresas')|default('Todas las empresas') }}</option>
                            {% for emp in fsc.empresas %}
                                <option value="{{ emp.id }}" {% if fsc.codEmpresa == emp.id %}selected{% endif %}>{{ emp.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>
            <div class="auralis-filters-right">
                <label for="vsAnterior" style="cursor: pointer; margin: 0; display: flex; align-items: center; gap: 0.5rem; white-space: nowrap;">
                    <input type="checkbox" id="vsAnterior" {% if fsc.vsAnterior %}checked{% endif %}>
                    {{ trans('vs-anterior')|default('vs Anterior') }}
                </label>
                {% if fsc.vsAnterior %}
                    <span class="badge bg-secondary text-white" style="font-size: 0.75rem;">
                        {{ fsc.rangoAnteriorFormated }}
                    </span>
                {% endif %}
            </div>
        </div>

        <!-- Tira de KPIs Generales -->
        <div class="auralis-kpi-row">
            <!-- Ventas Totales -->
            <div class="auralis-kpi-card">
                <div class="auralis-kpi-title">
                    {{ trans('ventas-totales')|default('Ventas Totales') }}
                    <i class="fa-solid fa-circle-info ms-1 text-muted" title="{{ trans('sales-net-tooltip')|default('Suma del neto de todas las facturas de clientes emitidas en el periodo. No incluye impuestos (valores netos).') }}"></i>
                </div>
                <div class="auralis-kpi-value">{{ fsc.ventasFormated }}</div>
                {% if fsc.vsAnterior %}
                    <div class="auralis-kpi-footer">
                        <span class="{{ fsc.ventasTrendClass }}">{{ fsc.ventasTrendSign }}{{ fsc.ventasTrendPct|number_format(1) }}%</span>
                        <span class="text-muted">{{ trans('vs-previous')|default('vs anterior') }}</span>
                    </div>
                {% endif %}
            </div>

            <!-- Compras Totales -->
            <div class="auralis-kpi-card">
                <div class="auralis-kpi-title">
                    {{ trans('compras-totales')|default('Compras Totales') }}
                    <i class="fa-solid fa-circle-info ms-1 text-muted" title="{{ trans('purchases-net-tooltip')|default('Suma del neto de facturas de proveedores en el periodo. No incluye impuestos (valores netos). No incluye nóminas ni amortizaciones.') }}"></i>
                </div>
                <div class="auralis-kpi-value">{{ fsc.gastosFormated }}</div>
                {% if fsc.vsAnterior %}
                    <div class="auralis-kpi-footer">
                        <span class="{{ fsc.gastosTrendClass }}">{{ fsc.gastosTrendSign }}{{ fsc.gastosTrendPct|number_format(1) }}%</span>
                        <span class="text-muted">{{ trans('vs-previous')|default('vs anterior') }}</span>
                    </div>
                {% endif %}
            </div>

            <!-- Margen Comercial -->
            <div class="auralis-kpi-card">
                <div class="auralis-kpi-title">
                    {{ trans('margen-comercial')|default('Margen Comercial') }}
                    <i class="fa-solid fa-circle-info ms-1 text-muted" title="{{ trans('net-margin-tooltip')|default('Diferencia entre Ventas Totales y Compras Totales (solo facturación comercial). No incluye impuestos.') }}"></i>
                </div>
                <div class="auralis-kpi-value {{ fsc.margen < 0 ? 'text-danger' : '' }}">{{ fsc.margenFormated }} <span class="fs-6 text-muted">({{ fsc.margenPct|number_format(1) }}%)</span></div>
                {% if fsc.vsAnterior %}
                    <div class="auralis-kpi-footer">
                        <span class="{{ fsc.margenTrendClass }}">{{ fsc.margenTrendSign }}{{ fsc.margenTrendPct|number_format(1) }}%</span>
                        <span class="text-muted">{{ trans('vs-previous')|default('vs anterior') }}</span>
                    </div>
                {% endif %}
            </div>

            <!-- Estimación de Impuestos -->
            <div class="auralis-kpi-card">
                <div class="auralis-kpi-title font-semibold">
                    {{ trans('tax-estimation')|default('Estimación Impuestos') }}
                    <i class="fa-solid fa-circle-info ms-1 text-muted" title="{{ trans('tax-estimation-tooltip')|default('Estimación basada en (IVA Repercutido - IVA Soportado) + Retenciones IRPF del periodo. Un importe positivo (en rojo) representa una estimación a pagar, mientras que un importe negativo (en verde) indica una estimación a favor o a devolver por la administración fiscal.') }}"></i>
                </div>
                {% if fsc.hasPurchases %}
                    <div class="auralis-kpi-value {{ fsc.impuestos < 0 ? 'text-success' : (fsc.impuestos > 0 ? 'text-danger' : '') }}">{{ fsc.impuestosFormated }}</div>
                    <div class="auralis-kpi-footer">
                        <span class="text-muted small">{{ trans('iva-irpf-estimado')|default('Estimación fiscal del periodo') }}</span>
                    </div>
                {% else %}
                    <div class="auralis-kpi-value fs-6 text-muted mt-2">
                        <i class="fa-solid fa-circle-info text-secondary me-1"></i>{{ trans('no-calculada')|default('No calculada') }}
                    </div>
                    <div class="auralis-kpi-footer">
                        <span class="text-muted small">{{ trans('no-compras-impuestos-msg')|default('No se calcula al no registrar compras/gastos') }}</span>
                    </div>
                {% endif %}
            </div>

            <!-- Liquidez Real -->
            <div class="auralis-kpi-card">
                <div class="auralis-kpi-title d-flex align-items-center justify-content-between">
                    <span>
                        {{ trans('real-liquidity')|default('Liquidez Real') }}
                        <i class="fa-solid fa-circle-info ms-1 text-muted" title="{{ trans('liquidity-tooltip') }}"></i>
                    </span>
                </div>
                {% if fsc.hasPurchases %}
                    <div class="auralis-kpi-value {{ fsc.liquidez < 0 ? 'text-danger' : '' }}">{{ fsc.liquidezFormated }}</div>
                    <div class="auralis-kpi-footer d-flex flex-column gap-1 pt-1 border-top mt-2">
                        <div class="d-flex justify-content-between align-items-center w-100">
                            <span class="text-muted" style="font-size: 0.75rem;">{{ trans('tesoreria-prevista')|default('Tesorería Prevista') }}</span>
                            <strong style="font-size: 0.75rem;" class="{{ fsc.liquidezFutura >= 0 ? 'text-success' : 'text-danger' }}">{{ fsc.liquidezFuturaFormated }}</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center w-100">
                            <span class="text-muted" style="font-size: 0.75rem;">{{ trans('vencido-pendiente') }}</span>
                            <strong style="font-size: 0.75rem;" class="{{ fsc.liquidezVencida >= 0 ? 'text-success' : 'text-danger' }}">{{ fsc.liquidezVencidaFormated }}</strong>
                        </div>
                    </div>
                {% else %}
                    <div class="auralis-kpi-value fs-6 text-muted mt-2">
                        <i class="fa-solid fa-circle-info text-secondary me-1"></i>{{ trans('no-disponible')|default('No disponible') }}
                    </div>
                    <div class="auralis-kpi-footer">
                        <span class="text-muted small">{{ trans('no-compras-liquidez-msg')|default('Requiere registrar compras/gastos en el sistema') }}</span>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Pestañas Móviles (Ubicadas justo después de los KPIs principales) -->
        <div class="auralis-mobile-tabs my-3">
            <button class="auralis-mobile-tab-btn active" data-tab="analytics">📊 {{ trans('analytics')|default('Analítica') }}</button>
            <button class="auralis-mobile-tab-btn" data-tab="treasury">💶 {{ trans('treasury')|default('Tesorería') }}</button>
        </div>

        <!-- Pestaña 1: Analítica (Evolución de Ingresos/Gastos + Top 5 Clientes) -->
        <div class="auralis-tab-pane auralis-pane-analytics">
            <div class="auralis-analytics-row">
                <!-- Gráfico de Evolución -->
                <div class="auralis-chart-card">
                    <div class="auralis-card-header auralis-evolution-header">
                        <div class="auralis-evolution-summary">
                            <div class="auralis-evolution-heading">
                                <span class="auralis-evolution-kicker">EVOLUCIÓN</span>
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    <h3 class="auralis-card-title mb-0">
                                        {{ fsc.evolutionDocument == 'albaranes' ? 'Albaranes' : 'Facturas' }}
                                        <span class="auralis-evolution-title-separator" aria-hidden="true">·</span>
                                        {{ fsc.evolutionMetric == 'total' ? 'Total con impuestos' : 'Importe neto' }}
                                    </h3>
                                    <span class="auralis-evolution-info" title="Elige el tipo de documento, el nivel de detalle y el formato del gráfico. La comparación usa el periodo inmediatamente anterior." aria-label="Información sobre el gráfico">
                                        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="auralis-evolution-period" aria-label="Periodo representado">
                                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                                <time datetime="{{ fsc.desde }}">{{ fsc.desde|date('d/m/Y') }}</time>
                                <i class="fa-solid fa-arrow-right-long auralis-evolution-period-arrow" aria-hidden="true"></i>
                                <time datetime="{{ fsc.hasta }}">{{ fsc.hasta|date('d/m/Y') }}</time>
                            </div>
                        </div>
                        <div class="auralis-evolution-controls" aria-label="Opciones del gráfico de evolución">
                            <label><span>Documentos</span><select id="evolutionDocument" class="form-select form-select-sm">
                                <option value="facturas" {% if fsc.evolutionDocument == 'facturas' %}selected{% endif %}>Facturas</option>
                                <option value="albaranes" {% if fsc.evolutionDocument == 'albaranes' %}selected{% endif %}>Albaranes</option>
                            </select></label>
                            <label><span>Agrupar</span><select id="evolutionGranularity" class="form-select form-select-sm">
                                <option value="auto" {% if fsc.evolutionGranularity == 'auto' %}selected{% endif %}>Automático</option>
                                <option value="day" {% if fsc.evolutionGranularity == 'day' %}selected{% endif %}>Días</option>
                                <option value="week" {% if fsc.evolutionGranularity == 'week' %}selected{% endif %}>Semanas</option>
                                <option value="month" {% if fsc.evolutionGranularity == 'month' %}selected{% endif %}>Meses</option>
                                <option value="year" {% if fsc.evolutionGranularity == 'year' %}selected{% endif %}>Años</option>
                            </select></label>
                            <label><span>Importe</span><select id="evolutionMetric" class="form-select form-select-sm">
                                <option value="neto" {% if fsc.evolutionMetric == 'neto' %}selected{% endif %}>Neto</option>
                                <option value="total" {% if fsc.evolutionMetric == 'total' %}selected{% endif %}>Total</option>
                            </select></label>
                            <label><span>Vista</span><select id="evolutionChart" class="form-select form-select-sm">
                                <option value="line" {% if fsc.evolutionChart == 'line' %}selected{% endif %}>Líneas</option>
                                <option value="bar" {% if fsc.evolutionChart == 'bar' %}selected{% endif %}>Barras</option>
                            </select></label>
                        </div>
                    </div>
                    <div class="auralis-evolution-chart">
                        <canvas id="zChartEvolution"></canvas>
                    </div>
                </div>

                <!-- Top 5 Clientes -->
                <div class="auralis-top-card">
                    <div class="auralis-card-header">
                        <h3 class="auralis-card-title">{{ trans('top-clients-title')|default('Top 5 Clientes') }}</h3>
                    </div>
                    <div class="auralis-bar-list">
                        {% for client in fsc.topClients %}
                            <div class="auralis-bar-item">
                                <div class="auralis-bar-labels">
                                    <span class="auralis-client-name">
                                        <a href="EditCliente?code={{ client.codcliente }}">{{ client.nombrecliente }}</a>
                                    </span>
                                    <span class="auralis-client-amount">
                                        {{ client.total_neto_formatted }}
                                        <span class="auralis-client-pct">({{ client.percentage|number_format(1) }}%)</span>
                                    </span>
                                </div>
                                <div class="auralis-bar-outer">
                                    <div class="auralis-bar-inner {% if client.percentage > 35 %}bg-warning{% endif %}" style="width: {{ client.percentage }}%;"></div>
                                </div>
                            </div>
                        {% else %}
                            <div class="text-center text-muted py-5">
                                {{ trans('no-sales-period')|default('No hay facturación registrada en este periodo.') }}
                            </div>
                        {% endfor %}
                    </div>

                    {% if fsc.hasClientRiskAlert %}
                        <div class="auralis-alert-concentration">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span><strong>{{ trans('concentration-alert-title')|default('Alerta de Concentración:') }}</strong> {{ trans('concentration-alert-desc')|default('Un cliente supera el 35% de la facturación total.') }}</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Pestaña 2: Tesorería (Resumen KPI de Recibos + Calendario) -->
        <div class="auralis-tab-pane auralis-pane-treasury">
            <!-- Bloque Resumen de Recibos (4 Tarjetas KPI) -->
            <div class="auralis-receipts-summary-section my-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="fw-bold fs-6 text-dark mb-0">
                        <i class="fa-solid fa-receipt me-2 text-primary"></i>{{ trans('resumen-tesoreria-recibos') }}
                    </h4>
                </div>

                <div class="row g-3">
                    <!-- Tarjeta 1: Recibos Ventas Vencidos -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100 border-start border-4 border-danger">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.75rem;">{{ trans('cobros-vencidos') }}</span>
                                    <span class="badge bg-danger-subtle text-danger rounded-pill">{{ fsc.recibosVentasVencidosCount }}</span>
                                </div>
                                <h3 class="fw-bold text-danger mb-1 fs-5">{{ fsc.recibosVentasVencidosTotalFormatted }}</h3>
                                <p class="text-muted small mb-3">{{ fsc.recibosVentasVencidosCount }} {{ trans('recibos-venta-pendientes-cobro') }}</p>
                                <button type="button" class="btn btn-sm btn-outline-danger w-100 fw-semibold" onclick="openReceiptsModal('ventas-vencidos')">
                                    <i class="fa-solid fa-eye me-1"></i>{{ trans('ver-detalle') }}
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 2: Recibos Ventas Por Vencer -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100 border-start border-4 border-success">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.75rem;">{{ trans('cobros-por-vencer') }}</span>
                                    <span class="badge bg-success-subtle text-success rounded-pill">{{ fsc.recibosVentasProximosCount }}</span>
                                </div>
                                <h3 class="fw-bold text-success mb-1 fs-5">{{ fsc.recibosVentasProximosTotalFormatted }}</h3>
                                <p class="text-muted small mb-3">{{ fsc.recibosVentasProximosCount }} {{ trans('recibos-venta-previstos-periodo') }}</p>
                                <button type="button" class="btn btn-sm btn-outline-success w-100 fw-semibold" onclick="openReceiptsModal('ventas-proximos')">
                                    <i class="fa-solid fa-eye me-1"></i>{{ trans('ver-detalle') }}
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 3: Recibos Compras Vencidos -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100 border-start border-4 border-warning">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.75rem;">{{ trans('pagos-vencidos') }}</span>
                                    <span class="badge bg-warning-subtle text-dark rounded-pill">{{ fsc.recibosComprasVencidosCount }}</span>
                                </div>
                                <h3 class="fw-bold text-dark mb-1 fs-5">{{ fsc.recibosComprasVencidosTotalFormatted }}</h3>
                                <p class="text-muted small mb-3">{{ fsc.recibosComprasVencidosCount }} {{ trans('recibos-compra-pendientes-pago') }}</p>
                                <button type="button" class="btn btn-sm btn-outline-danger w-100 fw-semibold" onclick="openReceiptsModal('compras-vencidos')">
                                    <i class="fa-solid fa-eye me-1"></i>{{ trans('ver-detalle') }}
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 4: Recibos Compras Por Vencer -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="card shadow-sm border-0 h-100 border-start border-4 border-info">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.75rem;">{{ trans('pagos-por-vencer') }}</span>
                                    <span class="badge bg-info-subtle text-dark rounded-pill">{{ fsc.recibosComprasProximosCount }}</span>
                                </div>
                                <h3 class="fw-bold text-primary mb-1 fs-5">{{ fsc.recibosComprasProximosTotalFormatted }}</h3>
                                <p class="text-muted small mb-3">{{ fsc.recibosComprasProximosCount }} {{ trans('recibos-compra-previstos-periodo') }}</p>
                                <button type="button" class="btn btn-sm btn-outline-success w-100 fw-semibold" onclick="openReceiptsModal('compras-proximos')">
                                    <i class="fa-solid fa-eye me-1"></i>{{ trans('ver-detalle') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                {# KPIs ciclo cobro/pago (sin subtítulo; debajo de las 4 cajas) #}
                {% if fsc.kpiCicloRangoAmpliado %}
                    <p class="small text-muted mb-2 mt-3">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        {{ trans('kpi-ciclo-rango-ampliado') }}
                        ({{ fsc.kpiCicloDesde|date('d/m/Y') }} – {{ fsc.kpiCicloHasta|date('d/m/Y') }}).
                    </p>
                {% endif %}
                <div class="row g-3 {% if not fsc.kpiCicloRangoAmpliado %}mt-1{% endif %}">
                    <div class="col-sm-6 col-lg-2">
                        <div class="card shadow-sm border-0 h-100 border-start border-4 border-success">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="mb-2">
                                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem;">
                                        {{ trans('kpi-ciclo-cobro-ventas') }}
