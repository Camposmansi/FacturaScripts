                                                </div>
                                                <button type="submit" name="delete_login_header_logo" value="1" class="btn btn-sm btn-outline-danger" title="{{ trans('eliminar') }}">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                <!-- Logotipo del Formulario (Área derecha) -->
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <label class="form-label fw-bold mb-2">Logotipo principal</label>
                                            <div class="mb-2">
                                                {{ fsc.getLogoLibraryWidget('login_logo_id', settings('auralis', 'login_logo_id'))|raw }}
                                            </div>
                                            <div class="form-text mb-2" style="font-size: 0.8rem;">Se muestra en el centro de la tarjeta de acceso y recuperación.</div>
                                            <div class="mt-3">
                                                <div class="d-flex justify-content-between mb-1">
