                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                        <h5 class="card-title mb-0 text-secondary" style="font-size: 1rem;">
                            <i class="fa-solid fa-eye me-2 text-primary"></i>{{ trans('previsualizacion-en-vivo') }}
                        </h5>
