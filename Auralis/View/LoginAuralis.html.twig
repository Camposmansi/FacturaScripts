<link rel="stylesheet" href="{{ asset('Dinamic/Assets/CSS/auralis-admin.css') }}?v=1.1"/>

<div class="auralis-admin-container mt-3">
    <div class="row">
        <!-- Panel de Configuración -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>{{ trans('configuracion-pantalla-login') }}
                    </h5>
                    <button type="submit" form="auralisLoginConfigForm" class="btn btn-primary btn-sm px-3">
                        <i class="fa-solid fa-floppy-disk me-1"></i>{{ trans('guardar') }}
                    </button>
                </div>
                <div class="card-body py-4">
                    <form method="post" action="{{ fsc.url() }}" id="auralisLoginConfigForm" enctype="multipart/form-data">
                        {{ formToken() }}
                        <input type="hidden" name="action" value="save_login"/>
                        <input type="hidden" name="activetab" value="LoginAuralis"/>
                        <script>(function(){var i=document.querySelector('#auralisLoginConfigForm input[name="multireqtoken"]');if(i&&i.value){window.AURALIS_LIBRARY_CSRF=i.value;}})();</script>

                        <!-- Sección 1: Textos -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary mb-3">
                                <i class="fa-solid fa-font me-2 text-primary"></i>{{ trans('textos-pantalla') }}
                            </label>

                            <div class="mb-3">
                                <label class="form-label" for="login_maintenance_warning">{{ trans('aviso-mantenimiento') }}</label>
                                <textarea class="form-control" name="login_maintenance_warning" id="login_maintenance_warning" rows="2" placeholder="{{ trans('placeholder-aviso-mantenimiento') }}">{{ settings('auralis', 'login_maintenance_warning') }}</textarea>
                                <div class="form-text">{{ trans('aviso-mantenimiento-help') }}</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="login_left_text">{{ trans('texto-presentacion-izquierda') }}</label>
                                <textarea class="form-control" name="login_left_text" id="login_left_text" rows="2" placeholder="Panel de Gestión&#10;Accede a tu plataforma empresarial">{{ settings('auralis', 'login_left_text', 'Panel de Gestión\nAccede a tu plataforma empresarial') }}</textarea>
                                <div class="form-text">{{ trans('texto-presentacion-help') }}</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="login_footer_text">{{ trans('texto-pie-pagina') }}</label>
                                <input type="text" class="form-control" name="login_footer_text" id="login_footer_text" value="{{ settings('auralis', 'login_footer_text', '© {year} Diseñado por MansiHost.com') }}">
                                <div class="form-text">{{ trans('texto-pie-pagina-help') }}</div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25"/>

                        <!-- Sección: Opciones de Recuperación de Contraseña -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary mb-3">
                                <i class="fa-solid fa-key me-2 text-primary"></i>{{ trans('recuperacion-contrasena') }}
                            </label>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="login_show_forgot_password" name="login_show_forgot_password" value="1" {{ settings('auralis', 'login_show_forgot_password', true) ? 'checked' : '' }}>
                                <label class="form-check-label fw-bold" for="login_show_forgot_password">
                                    {{ trans('mostrar-olvidado-contrasena') }}
                                </label>
                                <div class="form-text">{{ trans('mostrar-olvidado-contrasena-help') }}</div>
                            </div>

                            <div id="login_custom_recovery_block" class="{{ settings('auralis', 'login_show_forgot_password', true) ? '' : 'opacity-50' }}">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="login_custom_password_recovery" name="login_custom_password_recovery" value="1" {{ settings('auralis', 'login_custom_password_recovery', false) ? 'checked' : '' }} {{ settings('auralis', 'login_show_forgot_password', true) ? '' : 'disabled' }}>
                                    <label class="form-check-label fw-bold" for="login_custom_password_recovery">
                                        {{ trans('activar-recuperacion-personalizada') }}
                                    </label>
                                    <div class="form-text">{{ trans('activar-recuperacion-personalizada-help') }}</div>
                                </div>
                            </div>
                            <div class="alert alert-warning border-0 border-start border-4 border-warning bg-warning bg-opacity-10 p-3 mb-3 rounded-end">
                                <div class="d-flex align-items-start">
                                    <i class="fa-solid fa-envelope-circle-check fa-xl text-warning me-3 mt-1"></i>
                                    <div>
                                        <strong class="d-block text-dark mb-1" style="font-size: 0.95rem;">
                                            <i class="fa-solid fa-triangle-exclamation me-1 text-warning"></i> {{ trans('requisito-configuracion') }}
                                        </strong>
                                        <p class="text-secondary small mb-1">
                                            {{ trans('requisito-configuracion-desc') }}
                                        </p>
                                        <div class="bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded p-2 mt-2 text-wrap text-start" style="font-size: 0.82rem; font-weight: 600; line-height: 1.5;">
                                            <i class="fa-solid fa-circle-info me-1"></i>
                                            {{ trans('requisito-email-importante') }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25"/>

                        <!-- Sección 2: Identidad visual -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary mb-3">
                                <i class="fa-solid fa-wand-magic-sparkles me-2 text-primary"></i>Identidad visual
                            </label>

                            <div class="row g-3 mb-4">
                                <!-- Icono / Logo Cabecera (Área izquierda) -->
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <label class="form-label fw-bold mb-2">Marca secundaria <span class="text-muted fw-normal">(opcional)</span></label>
                                            <div class="mb-2">
                                                {{ fsc.getLogoLibraryWidget('login_header_logo_id', settings('auralis', 'login_header_logo_id'))|raw }}
                                            </div>
                                            <div class="form-text mb-2" style="font-size: 0.8rem;">Aparece discretamente en la esquina superior del portal.</div>
                                            <div class="mt-3">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <label class="form-label mb-0 small fw-semibold" for="login_header_logo_height">Alto (px)</label>
                                                    <span class="badge bg-light text-dark border" id="login_header_logo_height_val">{{ settings('auralis', 'login_header_logo_height', '55') }}px</span>
                                                </div>
                                                <input type="range" class="form-range" name="login_header_logo_height" id="login_header_logo_height" min="20" max="150" value="{{ settings('auralis', 'login_header_logo_height', '55') }}" oninput="document.getElementById('login_header_logo_height_val').textContent = this.value + 'px';"/>
                                            </div>
                                        </div>
                                        {% set loginHeaderLogo = settings('auralis', 'login_header_logo') %}
                                        {% if loginHeaderLogo %}
                                            <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded border mt-2">
                                                <div class="me-2 p-1 bg-light rounded border">
