                                    <div class="mb-2 p-2 bg-light rounded border" style="font-size: 8px; color:#64748b;"><i class="fa-solid fa-lock me-1"></i>{{ trans('contrasena') }}</div>
                                    <div class="btn btn-primary btn-sm w-100 py-1 fw-bold" style="font-size: 9px;">{{ trans('acceder') }}</div>
                                </div>
                                <div id="prev_mob_footer" class="position-absolute text-white-50 text-center" style="bottom: 9px; left: 8px; right: 8px; font-size: 6px;">{{ auralisFooterHtml(settings('auralis', 'login_footer_text', '© {year} Diseñado por MansiHost.com')) }}</div>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- Card sobre esta pantalla -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title mb-0 text-secondary">
                            <i class="fa-solid fa-circle-info me-2 text-primary"></i>{{ trans('sobre-esta-pantalla') }}
                        </h5>
                    </div>
                    <div class="card-body py-4 bg-light text-muted small">
                        <p>{{ trans('sobre-pantalla-desc') }}</p>
                        <ul>
                            <li><strong>{{ trans('escritorio') }}</strong> {{ trans('escritorio-desc') }}</li>
                            <li><strong>{{ trans('movil-tablet-label') }}</strong> {{ trans('movil-tablet-desc') }}</li>
                            <li><strong>{{ trans('aviso-mantenimiento-label') }}</strong> {{ trans('aviso-mantenimiento-desc') }}</li>
                        </ul>
