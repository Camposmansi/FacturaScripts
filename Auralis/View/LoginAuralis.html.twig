<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnPc = document.getElementById('btn_login_prev_pc');
    const btnMobile = document.getElementById('btn_login_prev_mobile');
    
    const stage = document.getElementById('login_preview_stage');
    const viewPc = document.getElementById('prev_view_pc');
    const viewMobile = document.getElementById('prev_view_mobile');

    function setActiveBtn(activeBtn) {
        [btnPc, btnMobile].forEach(btn => btn.classList.remove('active'));
        activeBtn.classList.add('active');
    }

    btnPc.addEventListener('click', function() {
        setActiveBtn(this);
        stage.style.maxWidth = '100%';
        viewPc.style.display = 'flex';
        viewMobile.style.display = 'none';
    });

    btnMobile.addEventListener('click', function() {
        setActiveBtn(this);
        stage.style.maxWidth = '65%';
        stage.style.margin = '0 auto';
        viewPc.style.display = 'none';
        viewMobile.style.display = 'flex';
    });

    // Reactividad en tiempo real con los campos del formulario
    const inputWarning = document.getElementById('login_maintenance_warning');
    const inputLeftText = document.getElementById('login_left_text');
    const inputFooterText = document.getElementById('login_footer_text');

    function renderFooterPreview(target, value) {
        if (!target) return;

        let decoded = value.replace(/\{year\}/g, String(new Date().getFullYear()));
        const decoder = document.createElement('textarea');
        for (let i = 0; i < 2; i++) {
            decoder.innerHTML = decoded;
            const next = decoder.value;
            if (next === decoded) break;
            decoded = next;
        }
        decoded = decoded.replace(/\\([:\/.?#=&_%\-])/g, '$1');

        const parsed = new DOMParser().parseFromString('<div>' + decoded + '</div>', 'text/html');
        const source = parsed.body.firstElementChild;
        target.textContent = '';
        if (!source) {
            target.textContent = decoded;
            return;
        }

        source.childNodes.forEach(node => {
            if (node.nodeType !== Node.ELEMENT_NODE || node.tagName.toLowerCase() !== 'a') {
                target.append(document.createTextNode(node.textContent || ''));
                return;
            }

            try {
                const url = new URL(node.getAttribute('href') || '', window.location.href);
                if (!['http:', 'https:'].includes(url.protocol)) throw new Error('URL no permitida');
                const link = document.createElement('a');
                link.href = url.href;
                link.target = '_blank';
                link.rel = 'noopener noreferrer';
                link.textContent = node.textContent || '';
                target.append(link);
            } catch (e) {
                target.append(document.createTextNode(node.textContent || ''));
            }
        });
    }

    if(inputWarning) {
        inputWarning.addEventListener('input', function() {
            const val = this.value.trim();
            const alerts = [document.getElementById('prev_pc_alert'), document.getElementById('prev_mob_alert')];
            const txts = [document.getElementById('prev_pc_alert_txt'), document.getElementById('prev_mob_alert_txt')];
            alerts.forEach(a => a.style.display = val ? 'block' : 'none');
            txts.forEach(t => t.textContent = val);
        });
    }

    if(inputLeftText) {
        inputLeftText.addEventListener('input', function() {
            const target = document.getElementById('prev_pc_left_text');
            if (target) {
                target.textContent = this.value;
            }
        });
    }

    if(inputFooterText) {
        inputFooterText.addEventListener('input', function() {
            const footers = [document.getElementById('prev_pc_footer'), document.getElementById('prev_mob_footer')];
            footers.forEach(f => renderFooterPreview(f, this.value));
        });
    }

    const inputHeaderLogoHeight = document.getElementById('login_header_logo_height');
    const inputLogoHeight = document.getElementById('login_logo_height');

    if (inputHeaderLogoHeight) {
        inputHeaderLogoHeight.addEventListener('input', function() {
            const val = this.value + 'px';
            const badge = document.getElementById('login_header_logo_height_val');
            if (badge) badge.textContent = val;
            const logoImgs = document.querySelectorAll('.prev-header-logo-img');
            logoImgs.forEach(img => img.style.height = val);
        });
    }

    if (inputLogoHeight) {
        inputLogoHeight.addEventListener('input', function() {
            const val = this.value + 'px';
            const badge = document.getElementById('login_logo_height_val');
            if (badge) badge.textContent = val;
            const logoImgs = document.querySelectorAll('.prev-form-logo-img');
            logoImgs.forEach(img => img.style.height = val);
        });
    }

    const showForgot = document.getElementById('login_show_forgot_password');
    const customRecovery = document.getElementById('login_custom_password_recovery');
    const customRecoveryBlock = document.getElementById('login_custom_recovery_block');

    function syncPasswordRecoveryToggles() {
        if (!showForgot || !customRecovery) {
            return;
        }
        const enabled = showForgot.checked;
        customRecovery.disabled = !enabled;
        if (customRecoveryBlock) {
            customRecoveryBlock.classList.toggle('opacity-50', !enabled);
        }
        if (!enabled) {
            customRecovery.checked = false;
        }
    }

    if (showForgot) {
        showForgot.addEventListener('change', syncPasswordRecoveryToggles);
        syncPasswordRecoveryToggles();
    }
});
</script>
