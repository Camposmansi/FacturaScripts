                            {% set prevHeaderLogo = settings('auralis', 'login_header_logo') %}
                            {% set prevFormLogo = settings('auralis', 'login_logo') ?: 'Dinamic/Assets/Images/auralis_rectangular_ancho_facturascripts.svg' %}
                            {% set prevLeftImg = settings('auralis', 'login_left_image') %}
                            {% set prevBg = settings('auralis', 'login_bg_image') %}

                            <!-- Vista de escritorio del Portal Auralis -->
                            <div id="prev_view_pc" class="position-relative w-100 overflow-hidden d-flex align-items-center justify-content-center p-3"
                                 style="display: flex; min-height: 280px; background: {% if prevBg %}linear-gradient(135deg, rgba(5,18,39,.86), rgba(28,74,128,.58)), url('{{ asset(prevBg) }}') center/cover{% else %}radial-gradient(circle at 18% 18%, rgba(116,92,255,.8), transparent 34%), linear-gradient(135deg,#07152b,#285eae){% endif %};">
                                {% if prevHeaderLogo %}
                                    <img src="{{ asset(prevHeaderLogo) }}" alt="Logo" class="prev-header-logo-img position-absolute" style="top: 12px; left: 12px; max-height: 20px; max-width: 80px;">
                                {% endif %}
                                {% if prevLeftImg %}
                                    <img src="{{ asset(prevLeftImg) }}" alt="" class="position-absolute" style="right: -12px; bottom: 4px; max-height: 130px; max-width: 42%; object-fit: contain; opacity: .18;">
                                {% endif %}
                                <div class="position-absolute w-100 h-100" style="inset:0; opacity:.12; background-image:linear-gradient(rgba(255,255,255,.2) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.2) 1px,transparent 1px); background-size:22px 22px;"></div>
                                <div class="position-relative bg-white p-3 shadow-lg text-dark" style="z-index:1; width: 47%; min-width: 150px; border-radius: 16px; background: rgba(255,255,255,.95)!important;">
                                    <div id="prev_pc_alert" class="alert alert-warning p-1 mb-2 text-truncate" style="font-size: 7px; display: {{ settings('auralis', 'login_maintenance_warning') ? 'block' : 'none' }};">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i><span id="prev_pc_alert_txt">{{ settings('auralis', 'login_maintenance_warning')|e }}</span>
                                    </div>
                                    <div class="text-center mb-2 fw-bold" style="font-size: 11px;">
                                        {% if prevFormLogo %}<img src="{{ asset(prevFormLogo) }}" alt="Logo" class="prev-form-logo-img" style="max-height: 25px; max-width: 100%;">{% else %}Auralis{% endif %}
                                        <div id="prev_pc_left_text" class="text-muted fw-normal mt-1" style="font-size: 6px; line-height: 1.35;">{{ settings('auralis', 'login_left_text', 'Panel de Gestión\nAccede a tu plataforma empresarial')|e|nl2br }}</div>
                                    </div>
                                    <div class="mb-1 p-1 bg-light rounded border" style="font-size: 7px; color:#94a3b8;"><i class="fa-regular fa-user me-1"></i>{{ trans('usuario') }}</div>
                                    <div class="mb-2 p-1 bg-light rounded border" style="font-size: 7px; color:#94a3b8;"><i class="fa-solid fa-lock me-1"></i>{{ trans('contrasena') }}</div>
                                    <div class="btn btn-primary btn-sm w-100 py-1" style="font-size: 8px;">{{ trans('acceder') }} <i class="fa-solid fa-arrow-right-long ms-1"></i></div>
                                </div>
                                <div id="prev_pc_footer" class="position-absolute text-white-50 text-center" style="bottom: 8px; left: 8px; right: 8px; font-size: 6px;">{{ auralisFooterHtml(settings('auralis', 'login_footer_text', '© {year} Diseñado por MansiHost.com')) }}</div>
                            </div>

                            <!-- Vista móvil del Portal Auralis -->
                            <div id="prev_view_mobile" class="position-relative flex-column align-items-center justify-content-center w-100 overflow-hidden p-3"
                                 style="display: none; min-height: 280px; background: {% if prevBg %}linear-gradient(135deg, rgba(5,18,39,.86), rgba(28,74,128,.58)), url('{{ asset(prevBg) }}') center/cover{% else %}radial-gradient(circle at 20% 15%, rgba(116,92,255,.8), transparent 35%), linear-gradient(145deg,#07152b,#285eae){% endif %};">
                                <div class="position-relative bg-white p-3 shadow-lg text-dark" style="z-index:1; width: 82%; max-width: 220px; border-radius: 16px; background:rgba(255,255,255,.95)!important;">
                                    <div id="prev_mob_alert" class="alert alert-warning p-1 mb-2 text-truncate" style="font-size: 7px; display: {{ settings('auralis', 'login_maintenance_warning') ? 'block' : 'none' }};">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i><span id="prev_mob_alert_txt">{{ settings('auralis', 'login_maintenance_warning')|e }}</span>
