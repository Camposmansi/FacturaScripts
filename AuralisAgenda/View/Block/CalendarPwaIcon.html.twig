{#
 # @package FacturaScripts
 # @author MansiHost.com
 # @description Selector de icono PWA (raster) en Config agenda; se reubica dentro del form EditView.
 #}
<div class="col-12 px-0 pb-0 mt-3 auralis-calendar-config-block">
    <div class="auralis-calendar-pwa-icon border rounded-3 p-3 bg-light">
        <div class="row align-items-center g-3">
            <div class="col-12 col-md-8">
                <div class="d-flex align-items-center gap-2 mb-1 fw-semibold auralis-calendar-config-title">
                    <i class="fa-solid fa-image text-primary" aria-hidden="true"></i>
                    <span>{{ trans('auralis-pwa-icon-title') }}</span>
                </div>
                <p class="auralis-calendar-config-help text-muted mb-2">{{ trans('auralis-pwa-icon-help') }}</p>
                <label class="form-label fw-semibold auralis-calendar-config-label mb-1">{{ trans('auralis-pwa-icon-select') }}</label>
                {{ fsc.getPwaIconLibraryWidget()|raw }}
            </div>
            <div class="col-12 col-md-4">
                {% set previewUrl = fsc.getPwaIconPreviewUrl() %}
                {% if previewUrl %}
                    <div class="d-flex align-items-center gap-3 bg-white border rounded p-2">
                        <img src="{{ previewUrl }}" width="48" height="48"
                             class="rounded border flex-shrink-0" alt="{{ trans('auralis-pwa-icon-title') }}"
                             style="object-fit: contain;"/>
                        <div class="auralis-calendar-config-help min-w-0">
                            <div class="fw-semibold text-body mb-1">{{ trans('auralis-pwa-icon-current') }}</div>
                            {% if fsc.hasCustomPwaIcon() %}
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" name="delete_calendar_pwa_icon"
                                           value="1" id="delete_calendar_pwa_icon"/>
                                    <label class="form-check-label text-danger" for="delete_calendar_pwa_icon">
                                        {{ trans('auralis-pwa-icon-delete') }}
                                    </label>
                                </div>
                            {% else %}
                                <span class="text-muted">{{ trans('auralis-pwa-icon-default') }}</span>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var block = document.getElementById('footer-calendar-pwa-icon');
        if (!block) {
            return;
        }
        var form = document.getElementById('formConfigCalendarioAuralis');
        if (!form) {
            return;
        }
        var cardBody = form.querySelector('.card-body');
        if (!cardBody) {
            return;
        }
        // RowFooter rinde fuera del form EditView; mover al card-body para que viaje con Guardar.
        cardBody.appendChild(block);
    })();
</script>
