<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Tabla de tipos/motivos de eventos para el calendario Auralis.
 */
-->
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>nombre</name>
        <type>character varying(100)</type>
        <null>NO</null>
    </column>
    <column>
        <name>color</name>
        <type>character varying(20)</type>
        <null>YES</null>
    </column>
    <column>
        <name>duracion</name>
        <type>integer</type>
        <null>YES</null>
    </column>
    <column>
        <name>origen_tipo</name>
        <type>character varying(50)</type>
        <default>'general'</default>
        <null>NO</null>
    </column>
    <column>
        <name>activo</name>
        <type>boolean</type>
        <default>true</default>
    </column>
    <constraint>
        <name>auralis_calendar_event_types_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <index>
        <name>auralis_cal_event_types_origen_idx</name>
        <columns>origen_tipo, activo</columns>
    </index>
</table>
