<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Vista de edición de una sala Auralis (almacén, nombre, descripción, activa).
 */
-->
<view>
    <columns>
        <group name="data" numcolumns="12" valign="center">
            <column name="code" display="none" order="100">
                <widget type="text" fieldname="idsala" readonly="dinamic"/>
            </column>
            <column name="name" numcolumns="6" order="110">
                <widget type="text" fieldname="nombre" required="true" maxlength="100"
                        icon="fa-solid fa-font"/>
            </column>
            <column name="warehouse" titleurl="ListAlmacen" numcolumns="4" order="120">
                <widget type="select" fieldname="codalmacen" required="true" onclick="EditAlmacen">
                    <values source="almacenes" fieldcode="codalmacen" fieldtitle="nombre"/>
                </widget>
            </column>
            <column name="active" numcolumns="2" order="130">
                <widget type="checkbox" fieldname="activa"/>
            </column>
            <column name="description" numcolumns="12" order="140">
                <widget type="textarea" fieldname="descripcion"/>
            </column>
        </group>
    </columns>
</view>
