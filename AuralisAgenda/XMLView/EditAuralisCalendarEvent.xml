<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Ficha central de evento de calendario Auralis.
 */
-->
<view>
    <columns>
        <group name="datos" numcolumns="12" title="auralis-calendar-event" icon="fa-solid fa-calendar-day">
            <column name="title" numcolumns="12" order="100">
                <widget type="text" fieldname="titulo" required="true"/>
            </column>
            <column name="date" numcolumns="3" order="120">
                <widget type="date" fieldname="fecha" required="true"/>
            </column>
            <column name="end-date" numcolumns="3" order="130">
                <widget type="date" fieldname="fecha_fin"/>
            </column>
            <column name="hour" numcolumns="3" order="140">
                <widget type="text" fieldname="hora_inicio"/>
            </column>
            <column name="duration" numcolumns="3" order="150">
                <widget type="number" fieldname="duracion" min="5" max="1440" step="5"/>
            </column>
            <column name="all-day" numcolumns="3" order="160" display="center">
                <widget type="checkbox" fieldname="todo_dia"/>
            </column>
            <column name="user" numcolumns="4" order="170">
                <widget type="select" fieldname="asignado">
                    <values source="users" fieldcode="nick" fieldtitle="nick"/>
                </widget>
            </column>
            <column name="auralis-sala" numcolumns="4" order="180">
                <widget type="select" fieldname="idsala">
                    <values source="auralis_salas" fieldcode="idsala" fieldtitle="nombre"/>
                </widget>
            </column>
            <column name="description" numcolumns="12" order="190">
                <widget type="textarea" fieldname="descripcion"/>
            </column>
            <column name="origen_tipo" display="none" order="900">
                <widget type="text" fieldname="origen_tipo" readonly="true"/>
            </column>
            <column name="status" display="none" order="910">
                <widget type="select" fieldname="estado" translate="true">
                    <values title="pending">pendiente</values>
                    <values title="auralis-estado-confirmado">confirmado</values>
                    <values title="completed">completado</values>
                    <values title="cancelled">cancelado</values>
                </widget>
            </column>
        </group>
    </columns>
</view>
