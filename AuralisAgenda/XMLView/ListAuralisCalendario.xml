<?xml version="1.0" encoding="UTF-8"?>
<!--
    @package FacturaScripts
    @author MansiHost.com
    @description Listado de calendarios comunes de empresa y de módulo (hub Agenda → Calendarios). Los personales no se listan.
-->
<view>
    <columns>
        <column name="code" order="100">
            <widget type="text" fieldname="codigo"/>
        </column>
        <column name="name" order="110">
            <widget type="text" fieldname="nombre"/>
        </column>
        <column name="type" order="120">
            <widget type="select" fieldname="tipo" translate="true">
                <values title="auralis-calendario-tipo-comun">comun</values>
                <values title="auralis-calendario-tipo-modulo">modulo</values>
                <values title="auralis-calendario-tipo-personal">personal</values>
            </widget>
        </column>
        <column name="color" display="center" order="130">
            <widget type="color" fieldname="color"/>
        </column>
        <column name="company" order="140">
            <widget type="select" fieldname="idempresa">
                <values source="empresas" fieldcode="idempresa" fieldtitle="nombrecorto"/>
            </widget>
        </column>
        <column name="active" display="center" order="150">
            <widget type="checkbox" fieldname="activo"/>
        </column>
        <column name="auralis-calendario-num-accesos" display="right" order="160">
            <widget type="number" fieldname="num_accesos" decimal="0"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="danger" fieldname="activo" title="inactive">0</option>
        </row>
    </rows>
</view>
