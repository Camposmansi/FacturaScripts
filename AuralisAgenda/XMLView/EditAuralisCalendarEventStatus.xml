<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Vista de edición de un estado de evento del calendario Auralis.
 */
-->
<view>
    <columns>
        <group name="data" numcolumns="12" valign="center">
            <column name="code" display="none" order="100">
                <widget type="text" fieldname="codestado" readonly="dinamic"/>
            </column>
            <column name="name" numcolumns="8" order="110">
                <widget type="text" fieldname="nombre" required="true" maxlength="100" icon="fa-solid fa-font"/>
            </column>
            <column name="calendar-status-order" description="calendar-status-order-help" numcolumns="4" order="120">
                <widget type="number" fieldname="orden" required="true" icon="fa-solid fa-arrow-down-1-9"/>
            </column>
            <column name="origen_tipo" numcolumns="6" order="140">
                <widget type="select" fieldname="origen_tipo" required="true">
                    <values>
                        <value code="general" title="calendar-origin-general"/>
                    </values>
                </widget>
            </column>
            <column name="active" numcolumns="6" order="150">
                <widget type="checkbox" fieldname="activo"/>
            </column>
        </group>
    </columns>
</view>
