<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Listado central de notificaciones programadas de calendario.
 */
-->
<view>
    <columns>
        <column name="date" order="100">
            <widget type="date" fieldname="fecha"/>
        </column>
        <column name="hour" order="110">
            <widget type="text" fieldname="hora_inicio"/>
        </column>
        <column name="title" order="120">
            <widget type="text" fieldname="titulo"/>
        </column>
        <column name="calendar-notif-plantilla" order="130">
            <widget type="text" fieldname="notification_name"/>
        </column>
        <column name="calendar-notif-programada-para" order="135">
            <widget type="datetime" fieldname="scheduled_at"/>
        </column>
        <column name="calendar-notif-antelacion" display="none" order="140">
            <widget type="number" fieldname="offset_value"/>
        </column>
        <column name="calendar-notif-unidad" display="none" order="150">
            <widget type="select" fieldname="offset_unit" translate="true">
                <values title="calendar-notif-minutes">minutes</values>
                <values title="calendar-notif-hours">hours</values>
                <values title="calendar-notif-days">days</values>
                <values title="calendar-notif-weeks">weeks</values>
            </widget>
        </column>
        <column name="calendar-notif-enviada" display="center" order="160">
            <widget type="checkbox" fieldname="sent"/>
        </column>
        <column name="calendar-notif-enviada-el" order="170">
            <widget type="datetime" fieldname="sent_at"/>
        </column>
        <column name="origen_tipo" display="none" order="900">
            <widget type="text" fieldname="origen_tipo"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="warning" fieldname="sent" title="calendar-notif-pendiente">0</option>
            <option color="success" fieldname="sent" title="calendar-notif-enviada">1</option>
        </row>
    </rows>
</view>
