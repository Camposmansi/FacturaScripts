<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * @package FacturaScripts
 * @author MansiHost.com
 * @description Listado central de eventos de calendario Auralis.
 */
-->
<view>
    <columns>
        <column name="date" order="100">
            <widget type="date" fieldname="fecha"/>
        </column>
        <column name="hour" order="110">
            <widget type="text" fieldname="hora_inicio"/>
        </column>
        <column name="title" order="120">
            <widget type="text" fieldname="titulo"/>
        </column>
        <column name="user" order="140">
            <widget type="select" fieldname="asignado">
                <values source="users" fieldcode="nick" fieldtitle="nick"/>
            </widget>
        </column>
        <column name="auralis-sala" order="160">
            <widget type="select" fieldname="idsala">
                <values source="auralis_salas" fieldcode="idsala" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="all-day" display="center" order="170">
            <widget type="checkbox" fieldname="todo_dia"/>
        </column>
        <column name="origen_tipo" display="none" order="900">
            <widget type="text" fieldname="origen_tipo"/>
        </column>
        <column name="status" display="none" order="910">
            <widget type="select" fieldname="estado" translate="true">
                <values title="pending">pendiente</values>
                <values title="auralis-estado-confirmado">confirmado</values>
                <values title="completed">completado</values>
                <values title="cancelled">cancelado</values>
            </widget>
        </column>
    </columns>
</view>
